# DropIt — configuration
PORT=8100
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8100
MAX_FILE_SIZE=42949672960
CHUNK_SIZE=8388608

# Kyros v4 obligatoire.
# Callback : PUBLIC_BASE_URL/auth/callback
AUTH_PROVIDER=kyros
KYROS_SSO_VERSION=v4
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard
KYROS_BASE_URL=https://kyros.example.fr
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:dropit
KYROS_REQUESTED_SCOPE=profile email
KYROS_REQUIRED_SCOPES=profile email
KYROS_TIMEOUT_SECONDS=5
KYROS_AUTHORIZE_URL=https://kyros.example.fr/authorize
KYROS_TOKEN_URL=https://kyros.example.fr/token
KYROS_PAR_URL=https://kyros.example.fr/par
KYROS_JWKS_URL=https://kyros.example.fr/sso/v4/jwks

UPLOADS_DIR=./uploads
DATA_DIR=./data

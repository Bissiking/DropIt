# ---- DropIt : fichier de configuration (copier en .env) ----
# Toutes les variables SSO suivent le guide docs/sso-guide.md.

PORT=8100
NODE_ENV=development

# URL de base publique du module (utilisée pour générer les liens courts)
PUBLIC_BASE_URL=http://localhost:8100

# Limites
MAX_FILE_SIZE=42949672960        # 40 Go max par fichier
CHUNK_SIZE=8388608               # 8 Mo par chunk d'upload

# ---- SSO Kyros (voir docs/sso-guide.md) ----
# En développement, laisser KYROS_CLIENT_ID vide pour un mode sans SSO.
KYROS_AUTH_PROVIDER=kyros
KYROS_BASE_URL=https://kyros.example.fr
KYROS_AUTHORIZE_URL=https://kyros.example.fr/authorize
KYROS_TOKEN_URL=https://kyros.example.fr/token
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_JWT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:dropit
KYROS_REQUESTED_SCOPE=profile email
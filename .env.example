# DropIt 1.1.0 — configuration initiale ; clients d’intégration gérés en base.
PORT=8100
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8100
MAX_FILE_SIZE=42949672960
CHUNK_SIZE=8388608

# Kyros v4 obligatoire, y compris en développement. Valeurs de l’inscription Kyros.
# Callback : PUBLIC_BASE_URL/auth/callback. Guide DOCS/RELEASE_1.1.0.md.
KYROS_BASE_URL=https://kyros.example.fr
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_ISSUER=https://kyros.example.fr
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:dropit
KYROS_REQUESTED_SCOPE=profile email offline_access
